{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "session-route": {
        "ClusterId": "session-cluster",
        "Match": {
          "Path": "/api/sessions/{**catch-all}"
        }
      },
      "signalr-charging-route": {
        "ClusterId": "session-cluster",
        "Match": {
          "Path": "/hubs/charging/{**catch-all}"
        }
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        }
      },
      "device-route": {
        "ClusterId": "device-cluster",
        "Match": {
          "Path": "/api/devices/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "session-cluster": {
        "Destinations": {
          "session-api": {
            "Address": "https+http://session-management-api"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing-api": {
            "Address": "https+http://billing-api"
          }
        }
      },
      "device-cluster": {
        "Destinations": {
          "device-api": {
            "Address": "https+http://device-management-api"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https+http://identity-api"
          }
        }
      }
    }
  }
}