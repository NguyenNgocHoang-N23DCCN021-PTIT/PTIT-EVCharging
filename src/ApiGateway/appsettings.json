{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "device-route": {
        "ClusterId": "device-cluster",
        "Match": {
          "Path": "/api/device/{**catch-all}"
        }
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "device-cluster": {
        "Destinations": {
          "device-api": {
            "Address": "https+http://device-management-api"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing-api": {
            "Address": "https+http://billing-api"
          }
        }
      }
    }
  }
}